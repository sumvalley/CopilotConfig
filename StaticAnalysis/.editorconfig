root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,yaml,yml,json,xml}]
indent_size = 2

[*.cs]
# https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/
# IDE0001 - Simplify name (System.String --> String)
dotnet_diagnostic.IDE0001.severity = suggestion

# IDE0002 - Simplify member access (ClassName.Field --> Field)
dotnet_diagnostic.IDE0002.severity = info

# IDE0003 - Name can be simplified (this.Field --> Field)
# IDE0009 - Member access should be qualified (Field --> this.Field)
dotnet_diagnostic.IDE0003.severity = info
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false

# IDE0004 - Remove unnecessary cast ((int)0 --> 0)
dotnet_diagnostic.IDE0004.severity = info

# IDE0005 - Remove unnecessary using
dotnet_diagnostic.IDE0005.severity = warning

# IDE0007 - Use var instead of explicit type
dotnet_diagnostic.IDE0007.severity = none

# IDE0008 - Use explicit type instead of var
dotnet_diagnostic.IDE0008.severity = none
dotnet_diagnostic.IDE0009.severity = none
csharp_style_var_for_built_in_types=false
csharp_style_var_when_type_is_apparent=false
csharp_style_var_elsewhere=false

# IDE009 - Add missing cases to switch statement
# IDE072 - Add missing cases to switch statement
dotnet_diagnostic.IDE0009.severity = warning
dotnet_diagnostic.IDE0072.severity = warning

# IDE011 - Prefer braces even when they're not required ( if (...) foo vs. if (...) { foo })
dotnet_diagnostic.IDE0011.severity = warning
csharp_prefer_braces = true

# IDE016 - Use throw expression instead of if/throw
dotnet_diagnostic.IDE0016.severity = suggestion
csharp_style_throw_expression = true

# IDE017 - Use object initializers
dotnet_diagnostic.IDE0017.severity = none
dotnet_style_object_initializer = true

# IDE018 - Inline variable declaration
dotnet_diagnostic.IDE0018.severity = suggestion
csharp_style_inlined_variable_declaration = true

# IDE019 - Use `o is string s` instead of `var s = o as string; if (s != null)`
dotnet_diagnostic.IDE0019.severity = suggestion
csharp_style_pattern_matching_over_as_with_null_check = true

# IDE020 - Use `o is int i` instead of `if (o is int) { var i = (int) o }`
dotnet_diagnostic.IDE0020.severity = suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true

# IDE021 - Use expression body for constructors
dotnet_diagnostic.IDE0021.severity = suggestion
csharp_style_expression_bodied_constructors = when_on_single_line

# Prefer "public static" over "static public"
csharp_preferred_modifier_order = public_static_first:suggestion

# Prefer x ?? y over x != null ? x : y
dotnet_style_null_propagation = true:info

# Prefer += over x = x +
dotnet_style_prefer_compound_assignment = true:suggestion

# Add readonly modifier to unmodified fields
dotnet_style_readonly_field = true:info

# Always include braces for if/else/for/while blocks
csharp_prefer_braces = true:warning
